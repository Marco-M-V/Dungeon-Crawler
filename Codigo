}

/* 
   MOVIMENTO DO JOGADOR
    */
void moverJogador(int dir) {
    int nl = jog.lin, nc = jog.col;
    jog.dir = dir;

    switch (dir) {
        case CIMA:  nl--; break;
        case BAIXO: nl++; break;
        case ESQ:   nc--; break;
        case DIR:   nc++; break;
    }

    /* limites do mapa */
    if (nl < 0 || nl >= mapa.linhas || nc < 0 || nc >= mapa.colunas) return;

    char destino = mapa.grid[nl][nc];

    if (ehParede(destino)) return; /* parede, caixa ou porta fechada */

    /* mover de fato */
    jog.lin = nl;
    jog.col = nc;

    /* espinho mata */
    if (mapa.grid[nl][nc] == C_ESPINHO) {
        perderVida();
        return;
    }
    /* chave: coleta automaticamente ao pisar */
    if (mapa.grid[nl][nc] == C_CHAVE) {
        jog.chaves++;
        mapa.grid[nl][nc] = C_VAZIO;
    }
}

/* 
   INTERAGIR (tecla i) - olha a celula a frente
    */
void interagir(void) {
    int fl = jog.lin, fc = jog.col;
    switch (jog.dir) {
        case CIMA:  fl--; break;
        case BAIXO: fl++; break;
        case ESQ:   fc--; break;
        case DIR:   fc++; break;
    }
    if (fl < 0 || fl >= mapa.linhas || fc < 0 || fc >= mapa.colunas) return;

    char alvo = mapa.grid[fl][fc];

    /* NPC: escolher arma (somente na vila) */
    if (alvo == C_NPC) {
        escolherArma();
        return;
    }
    /* Porta fechada: abre se tiver chave */
    if (alvo == C_PORTAF) {
        if (jog.chaves > 0) {
            jog.chaves--;
            mapa.grid[fl][fc] = C_PORTAA;
            mensagem("Voce usou uma chave e abriu a porta!");
        } else {
            mensagem("A porta esta trancada. Voce precisa de uma chave (@).");
        }
        return;
    }
    /* Botao */
    if (alvo == C_BOTAO) {
        botaoAtivado = !botaoAtivado;
        /* efeito do botao: remove uma barreira de espinhos perto da escada
           no andar 2; no andar 3, alterna paredes-armadilha simples.       */
        if (andarAtual == 2) {
            /* abre o caminho da escada removendo os espinhos ao redor */
            int i, j;
            for (i = 0; i < mapa.linhas; i++)
                for (j = 0; j < mapa.colunas; j++)
                    if (mapa.grid[i][j] == C_ESPINHO) mapa.grid[i][j] = C_VAZIO;
            mensagem("CLIQUE! Os espinhos que cercavam a escada recuaram. O caminho ate a escada (L) foi liberado!");
        } else {
            mensagem("CLIQUE! Algo se moveu na masmorra...");
        }
        return;
    }
    mensagem("Nao ha nada para interagir aqui.");
}

/* 
   ATAQUE (tecla o) - varia conforme a arma
    */
static void tentarDestruir(int l, int c) {
    if (l < 0 || l >= mapa.linhas || c < 0 || c >= mapa.colunas) return;

    /* destruir caixa */
    if (mapa.grid[l][c] == C_CAIXA) {
        mapa.grid[l][c] = C_VAZIO;
    }
    /* matar monstro/boss na celula */
    int k;
    for (k = 0; k < numMonstros; k++) {
        if (monstros[k].vivo && monstros[k].lin == l && monstros[k].col == c) {
            monstros[k].hp--;
            if (monstros[k].hp <= 0) monstros[k].vivo = 0;
        }
    }
}

void atacar(void) {
    int l = jog.lin, c = jog.col;
    int i, j;

    if (jog.arma == ARMA_ESPADA) {
        /* 3x2 a frente: 3 de largura, 2 de profundidade */
        if (jog.dir == CIMA) {
            for (i = 1; i <= 2; i++)
                for (j = -1; j <= 1; j++) tentarDestruir(l - i, c + j);
        } else if (jog.dir == BAIXO) {
            for (i = 1; i <= 2; i++)
                for (j = -1; j <= 1; j++) tentarDestruir(l + i, c + j);
        } else if (jog.dir == ESQ) {
            for (i = 1; i <= 2; i++)
                for (j = -1; j <= 1; j++) tentarDestruir(l + j, c - i);
        } else { /* DIR */
            for (i = 1; i <= 2; i++)
                for (j = -1; j <= 1; j++) tentarDestruir(l + j, c + i);
        }
    }
    else if (jog.arma == ARMA_ARCO) {
        /* 4 celulas em linha reta a frente */
        for (i = 1; i <= 4; i++) {
            if (jog.dir == CIMA)  tentarDestruir(l - i, c);
            if (jog.dir == BAIXO) tentarDestruir(l + i, c);
            if (jog.dir == ESQ)   tentarDestruir(l, c - i);
            if (jog.dir == DIR)   tentarDestruir(l, c + i);
        }
    }
    else if (jog.arma == ARMA_CAJADO) {
        /* 8 celulas adjacentes, independente da direcao */
        for (i = -1; i <= 1; i++)
            for (j = -1; j <= 1; j++) {
                if (i == 0 && j == 0) continue;
                tentarDestruir(l + i, c + j);
            }
    }
}

/* 
   IA DOS MONSTROS
    */
void moverMonstro1(Monstro *m) {
    /* movimento aleatorio: 1 unidade numa direcao aleatoria */
    int d = rand() % 4;
    int nl = m->lin, nc = m->col;
    switch (d) {
        case CIMA:  nl--; break;
        case BAIXO: nl++; break;
        case ESQ:   nc--; break;
        case DIR:   nc++; break;
    }
    if (nl < 0 || nl >= mapa.linhas || nc < 0 || nc >= mapa.colunas) return;
    if (ehParede(mapa.grid[nl][nc])) return;
    m->lin = nl; m->col = nc;
}

void moverMonstro2(Monstro *m) {
    /* perseguicao simples: reduz a maior diferenca, sem detectar obstaculo */
    int dl = jog.lin - m->lin;
    int dc = jog.col - m->col;
    int nl = m->lin, nc = m->col;

    if (abs(dl) >= abs(dc)) {
        if (dl > 0) nl++;
        else if (dl < 0) nl--;
    } else {
        if (dc > 0) nc++;
        else if (dc < 0) nc--;
    }
    if (nl < 0 || nl >= mapa.linhas || nc < 0 || nc >= mapa.colunas) return;
    if (ehParede(mapa.grid[nl][nc])) return; /* nao atravessa parede */
    m->lin = nl; m->col = nc;
}

void moverBoss(Monstro *m) {
    /* COMPORTAMENTO UNICO DO BOSS:
       - persegue o jogador como o monstro 2, MAS a cada 4 turnos dispara um
         "teleporte-investida": pula 2 celulas na direcao do jogador,
         atravessando o vazio (cobre distancia maior que qualquer monstro).
       - se ficar adjacente ao jogador, ele "carrega" e se move 2x no turno. */
    static int turno = 0;
    turno++;

    int passos = 1;
    if (turno % 4 == 0) passos = 2; /* investida */

    int p;
    for (p = 0; p < passos; p++) {
        int dl = jog.lin - m->lin;
        int dc = jog.col - m->col;
        int nl = m->lin, nc = m->col;

        if (abs(dl) >= abs(dc)) {
            if (dl > 0) nl++; else if (dl < 0) nl--;
        } else {
            if (dc > 0) nc++; else if (dc < 0) nc--;
        }
        if (nl < 0 || nl >= mapa.linhas || nc < 0 || nc >= mapa.colunas) break;
        if (ehParede(mapa.grid[nl][nc])) break;
        m->lin = nl; m->col = nc;
    }
}

void moverMonstros(void) {
    int k;
    for (k = 0; k < numMonstros; k++) {
        if (!monstros[k].vivo) continue;
        if (monstros[k].tipo == C_MON1) moverMonstro1(&monstros[k]);
        else if (monstros[k].tipo == C_MON2) moverMonstro2(&monstros[k]);
        else if (monstros[k].tipo == C_BOSS) moverBoss(&monstros[k]);
    }
}

int colisaoMonstro(void) {
    int k;
    for (k = 0; k < numMonstros; k++) {
        if (monstros[k].vivo &&
            monstros[k].lin == jog.lin &&
            monstros[k].col == jog.col)
            return 1;
    }
    return 0;
}

/* 
   VIDAS / DERROTA
    */
void perderVida(void) {
    jog.vidas--;
    if (jog.vidas <= 0) {
        jog.vivo = 0;
        return;
    }
    mensagem("Voce perdeu uma vida! A fase vai reiniciar.");
    resetAndar(); /* reinicia a fase do inicio */
}

