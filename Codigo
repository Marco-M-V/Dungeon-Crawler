//Utilitarios 
void limparTela(void) {
    system("cls");
}

char simboloJogador(void) {
    switch (jog.dir) {
        case CIMA:  return '^';
        case BAIXO: return 'v';
        case ESQ:   return '<';
        case DIR:   return '>';
    }
    return '^';
}

int ehParede(char c) {
    /* celulas que bloqueiam o movimento */
    return (c == C_PAREDE || c == C_CAIXA || c == C_PORTAF);
}

void mensagem(const char *msg) {
    printf("\n>> %s\n", msg);
    printf("   (pressione qualquer tecla para continuar)\n");
    _getch();
}

/* 
   DESENHO DO MAPA */

void desenhar(void) {
    int i, j, k;
    limparTela();

    printf("=== DUNGEON CRAWLER ===   ");
    if (andarAtual == 0) printf("Local: VILA\n");
    else printf("Andar: %d / 3\n", andarAtual);

    printf("Vidas: ");
    for (i = 0; i < jog.vidas; i++) printf("<3 ");
    printf("  |  Arma: ");
    if (jog.arma == ARMA_ESPADA) printf("Espada");
    else if (jog.arma == ARMA_ARCO) printf("Arco e Flecha");
    else if (jog.arma == ARMA_CAJADO) printf("Cajado");
    else printf("(nenhuma)");
    printf("  |  Chaves: %d\n", jog.chaves);
    printf("------------------------------------------\n");

    for (i = 0; i < mapa.linhas; i++) {
        for (j = 0; j < mapa.colunas; j++) {
            char out = mapa.grid[i][j];

            /* sobrepoe monstros vivos */
            for (k = 0; k < numMonstros; k++) {
                if (monstros[k].vivo && monstros[k].lin == i && monstros[k].col == j)
                    out = monstros[k].tipo;
            }
            /* sobrepoe o jogador (prioridade maxima) */
            if (jog.lin == i && jog.col == j)
                out = simboloJogador();

            printf("%c", out);
        }
        printf("\n");
    }
    printf("------------------------------------------\n");
    printf("[w/a/s/d] mover  [i] interagir  [o] atacar  [q] menu\n");
}

/* ===================================================================
   MAPAS  (cada andar e montado a partir de uma string de layout)
   =================================================================== */
static void montarMapa(const char *layout, int linhas, int colunas) {
    int i, j, idx = 0;
    mapa.linhas = linhas;
    mapa.colunas = colunas;
    numMonstros = 0;
    botaoAtivado = 0;

    for (i = 0; i < linhas; i++) {
        for (j = 0; j < colunas; j++) {
            char c = layout[idx++];
            char chao = C_VAZIO;

            switch (c) {
                case 'P': /* posicao inicial do jogador */
                    jog.lin = i; jog.col = j; jog.dir = CIMA;
                    chao = C_VAZIO;
                    break;
                case C_MON1:
                case C_MON2:
                    monstros[numMonstros].lin = i;
                    monstros[numMonstros].col = j;
                    monstros[numMonstros].tipo = c;
                    monstros[numMonstros].vivo = 1;
                    monstros[numMonstros].hp = 1;
                    numMonstros++;
                    chao = C_VAZIO;
                    break;
                case C_BOSS:
                    monstros[numMonstros].lin = i;
                    monstros[numMonstros].col = j;
                    monstros[numMonstros].tipo = c;
                    monstros[numMonstros].vivo = 1;
                    monstros[numMonstros].hp = 5; /* boss aguenta 5 hits */
                    numMonstros++;
                    chao = C_VAZIO;
                    break;
                default:
                    chao = c; /* parede, espinho, chave, porta, etc. */
                    break;
            }
            mapa.grid[i][j] = chao;
        }
    }
    jog.chaves = 0;
}

