/* ===================================================================
   LOOP DE UM ANDAR
   Retorna: 1 = avancou (pegou escada / matou boss)
            0 = game over
           -1 = saiu pro menu
   =================================================================== */
int jogarAndar(void) {
    int tecla;
    int bossVivoInicial = 0;
    int k;

    /* o boss existe neste andar? */
    for (k = 0; k < numMonstros; k++)
        if (monstros[k].tipo == C_BOSS) bossVivoInicial = 1;

    while (1) {
        desenhar();

        /* checa colisao logo apos desenhar (caso monstro tenha vindo) */
        if (colisaoMonstro()) {
            perderVida();
            if (!jog.vivo) return 0;
            continue;
        }

        tecla = _getch();

        if (tecla == 'q') return -1;
        else if (tecla == 'w') moverJogador(CIMA);
        else if (tecla == 's') moverJogador(BAIXO);
        else if (tecla == 'a') moverJogador(ESQ);
        else if (tecla == 'd') moverJogador(DIR);
        else if (tecla == 'i') interagir();
        else if (tecla == 'o') atacar();
        else continue; /* tecla invalida: nao gasta turno */

        if (!jog.vivo) return 0; /* morreu por espinho */

        /* a vila nao tem monstros se movendo, mas mantemos generico */
        moverMonstros();

        if (colisaoMonstro()) {
            perderVida();
            if (!jog.vivo) return 0;
            continue;
        }

        /* vitoria por boss: se este andar tinha boss e ele morreu */
        if (bossVivoInicial) {
            int bossVivo = 0;
            for (k = 0; k < numMonstros; k++)
                if (monstros[k].tipo == C_BOSS && monstros[k].vivo) bossVivo = 1;
            if (!bossVivo) return 2; /* codigo especial: matou o boss */
        }

        /* chegou na escada? */
        if (mapa.grid[jog.lin][jog.col] == C_ESCADA)
            return 1;
    }
}

/* 
   LOOP PRINCIPAL DO JOGO (do menu Jogar)
    */
void loopJogo(void) {
    int r;

    /* inicializa jogador */
    jog.vidas = 3;
    jog.arma = 0;
    jog.vivo = 1;
    jog.chaves = 0;

    /* ----- VILA ----- */
    carregarVila();
    r = jogarAndar();
    if (r == -1) return;          /* saiu */
    if (r == 0) { telaGameOver(); return; }
    /* exige ter escolhido arma antes de descer */
    if (jog.arma == 0) {
        mensagem("Voce precisa falar com o NPC (N) e escolher uma arma antes de descer!");
        /* recarrega a vila para tentar de novo */
        carregarVila();
        r = jogarAndar();
        if (r <= 0) { if (r == 0) telaGameOver(); return; }
        if (jog.arma == 0) {
            mensagem("Sem arma, sem masmorra. Voltando ao menu.");
            return;
        }
    }

    /* ----- ANDAR 1 ----- */
    carregarAndar1();
    r = jogarAndar();
    if (r == -1) return;
    if (r == 0) { telaGameOver(); return; }

    /* ----- ANDAR 2 ----- */
    carregarAndar2();
    r = jogarAndar();
    if (r == -1) return;
    if (r == 0) { telaGameOver(); return; }

    /* ----- ANDAR 3 ----- */
    carregarAndar3();
    r = jogarAndar();
    if (r == -1) return;
    if (r == 0) { telaGameOver(); return; }
    if (r == 2) { telaVitoria(); return; } /* matou o boss */
}

