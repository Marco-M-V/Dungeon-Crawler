/* Constantes globais */
#define MAX_LIN 25
#define MAX_COL 25

/* Caracteres do mapa (conforme a lauda) */
#define C_PAREDE   '*'
#define C_ESPINHO  '#'
#define C_CAIXA    'k'
#define C_BOTAO    'O'
#define C_PORTAF   'D'
#define C_CHAVE    '@'
#define C_PORTAA   '='
#define C_ESCADA   'L'
#define C_MON1     'X'
#define C_MON2     'Y'
#define C_BOSS     'Z'
#define C_VAZIO    ' '
#define C_NPC      'N'

/* Direcoes */
#define CIMA   0
#define BAIXO  1
#define ESQ    2
#define DIR    3

/* Armas */
#define ARMA_ESPADA 1
#define ARMA_ARCO   2
#define ARMA_CAJADO 3

/* Estruturas */
typedef struct {
    char grid[MAX_LIN][MAX_COL]; /* o que esta "no chao" (sem o jogador) */
    int  linhas, colunas;
} Mapa;

typedef struct {
    int lin, col;
    int dir;       
    int vidas;
    int arma;
    int chaves;     
    int vivo;
} Jogador;

typedef struct {
    int lin, col;
    char tipo;     
    int vivo;
    int hp;         
} Monstro;

